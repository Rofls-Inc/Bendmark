{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Agent": {
    "Address": "http://agent:50051",
    "RequestTimeoutSeconds": 5,
    "BusyRetryCount": 3,
    "BusyRetryDelaySeconds": 5
  },
  "Analyzer": {
    "Address": "http://analyzer:50052",
    "TimeoutSeconds": 10
  }
}
